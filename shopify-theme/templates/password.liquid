{% layout 'password' %}
<div class="wrap narrow stack-lg section">
  <h1 class="h2">{{ shop.name }}</h1>
  {%- form 'storefront_password', class: 'stack-lg' -%}
    {%- if form.errors -%}<p class="error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="field">
      <label for="password">Password</label>
      <input id="password" type="password" name="password" autocomplete="current-password">
    </div>
    <div><button class="btn btn--primary" type="submit">Enter</button></div>
  {%- endform -%}
</div>
